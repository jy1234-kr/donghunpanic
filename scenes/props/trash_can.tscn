extends Node3D

@export var trash_can: Area3D

func _ready() -> void:
    trash_can.collision_layer = 0
    trash_can.collision_mask = 2
    trash_can.add_to_group("interactables")

func interact(_player: Node3D) -> void:
    if not _player.has_method("reduce_panic"):
        return
    _player.reduce_panic(10.0, "우산으로 패닉 감소")
    get_tree().call_group("hud", "show_message", "우산 찾았습니다! 패닉이 줄었습니다.", 2.0)
    trash_can.queue_free()